{
  "name": "ei-model-v2",
  "version": "1.0.0",
  "description": "Edge Impulse C++ SDK + model (my train model #1133771, 96x96 image, 3 classes: bird/unknown/wildboar)",
  "frameworks": "arduino",
  "platforms": ["espressif32"],
  "build": {
    "srcDir": ".",
    "includeDir": ".",
    "srcFilter": [
      "+<tflite-model/**>",
      "+<edge-impulse-sdk/classifier/**>",
      "+<edge-impulse-sdk/dsp/**>",
      "+<edge-impulse-sdk/porting/espressif/**>",
      "+<edge-impulse-sdk/tensorflow/**>"
    ]
  }
}
